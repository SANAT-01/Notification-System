{
  "name": "notification-lab-service",
  "version": "1.0.0",
  "private": true,
  "description": "Notification lab producer/worker service (RabbitMQ fan-out, Redis idempotency, retry + DLQ)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start:producer": "node src/producer/index.js",
    "start:worker": "node src/worker/index.js",
    "dev:producer": "node --watch src/producer/index.js",
    "dev:worker": "node --watch src/worker/index.js",
    "lint": "eslint src"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.9.1"
  }
}
